# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0

# Optional allowlist. Comma-separated E.164 digits without +, e.g. 919876543210
ALLOWED_WHATSAPP_SENDERS=

# Supabase server-side configuration
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=whatsapp-media

# Safety limit for inbound media. Default: 15 MiB.
MAX_MEDIA_BYTES=15728640
