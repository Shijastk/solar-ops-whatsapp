# Meta / WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v26.0

# Optional allowlist. Comma-separated E.164 digits without +, e.g. 919876543210
ALLOWED_WHATSAPP_SENDERS=

# Supabase server-side configuration
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=whatsapp-media

# Safety limit for inbound media. Default: 15 MiB.
MAX_MEDIA_BYTES=15728640

# Optional local media-retention settings. The scheduled GitHub workflow uses 24 hours / 500 rows.
MEDIA_RETENTION_HOURS=24
MEDIA_RETENTION_BATCH_SIZE=500
MEDIA_RETENTION_REPORT_DIR=artifacts/media-retention

# Required for /ops dashboard login; keep separate from all Meta/WhatsApp credentials.
# If unset, dashboard login and session validation fail closed.
OPS_ACCESS_KEY=


# Groq is used for document verification and natural-language intent classification.
# Runtime activation is controlled in the authenticated /ops/settings portal.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=7000

